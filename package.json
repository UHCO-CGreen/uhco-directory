{
  "name": "uhco-ident-styles",
  "private": true,
  "scripts": {
    "build": "npm run build:icons && npm run build:libphonenumber && npm run build:styles",
    "build:icons": "node scripts/copy-bootstrap-icons.mjs",
    "build:libphonenumber": "node scripts/copy-libphonenumber.mjs",
    "scaffold:css:app": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tools/css-platform/scaffold-app.ps1",
    "build:styles": "sass --no-source-map --style=compressed --load-path=node_modules assets/css/src/apps/uhco-identity/admin.scss:assets/css/dist/admin/admin.css assets/css/src/apps/uhco-identity/userreview.scss:assets/css/dist/userreview/userreview.css assets/css/src/apps/uhco-identity/api.scss:assets/css/dist/api/api-docs.css",
    "watch:styles": "sass --watch --no-source-map --style=expanded --load-path=node_modules assets/css/src/apps/uhco-identity/admin.scss:assets/css/dist/admin/admin.css assets/css/src/apps/uhco-identity/userreview.scss:assets/css/dist/userreview/userreview.css assets/css/src/apps/uhco-identity/api.scss:assets/css/dist/api/api-docs.css"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.11.3",
    "libphonenumber-js": "^1.13.8"
  },
  "devDependencies": {
    "sass": "^1.89.0"
  }
}
